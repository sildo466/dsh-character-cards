{
  "name": "dsh-character-cards",
  "version": "0.1.0",
  "description": "Switchable identity cards (.dshcd) for DSH agents: tone, persona, and code style bound to one session's prompt section.",
  "author": "Sildo466",
  "repository": {
    "type": "git",
    "url": "https://github.com/sildo466/dsh-character-cards.git"
  },
  "homepage": "https://github.com/sildo466/dsh-character-cards#readme",
  "bugs": {
    "url": "https://github.com/sildo466/dsh-character-cards/issues"
  },
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "test": "node --test"
  },
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "persona",
    "character-card"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2"
  }
}
